<?xml version="1.0" encoding="utf-8"?>
<!-- The commute widget: 3×2 by default, resizable both ways; tall enough, it shows two commutes.
     It never asks for periodic updates: its own alarms refresh it during a commute's window.
     Below API 31 and 28 the launcher ignores the cell targets and reconfiguring; min sizes apply. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:configure="com.straphanger.app.widget.CommuteWidgetConfigActivity"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
